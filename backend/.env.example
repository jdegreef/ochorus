# Ochorus backend configuration. Copy to `.env` for local development.

# --- Local development -------------------------------------------------------
# Turn on debug locally so the app runs on SQLite with no external services.
DJANGO_DEBUG=true

# --- Production (leave unset locally) ----------------------------------------
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_ALLOWED_HOSTS=ochorus.org,api.ochorus.org
# DATABASE_URL=postgresql://...supabase pooler connection string...
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=            # only if using legacy HS256 secret
# CORS_ALLOWED_ORIGINS=https://ochorus.org
# CSRF_TRUSTED_ORIGINS=https://ochorus.org
