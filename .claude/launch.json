{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "ochorus-frontend",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev", "--", "--port", "5180", "--strictPort"],
			"cwd": "frontend",
			"port": 5180,
			"autoPort": false
		},
		{
			"name": "ochorus-web-preview",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "preview", "--", "--port", "4173", "--strictPort"],
			"cwd": "frontend",
			"port": 4173,
			"autoPort": false
		},
		{
			"name": "ochorus-backend",
			"runtimeExecutable": "uv",
			"runtimeArgs": ["run", "python", "manage.py", "runserver", "8000"],
			"cwd": "backend",
			"port": 8000,
			"autoPort": false
		}
	]
}
