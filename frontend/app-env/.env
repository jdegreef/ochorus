# Build settings for the native app — the ONLY env files its build reads
# (svelte.config.js points SvelteKit's env dir here when OCHORUS_TARGET=app), so
# a web developer's frontend/.env can't leak into the app bundle. Every value
# here is PUBLIC (it ships in the website's bundle too), so it is committed.
# Local overrides go in app-env/.env.local (git-ignored); a real environment
# variable beats both, which is how `PUBLIC_API_BASE_URL=… npm run app:build`
# points a build at a local API.
#
# Not set on purpose: PUBLIC_SUPABASE_ANON_KEY (the website's sign-in flows
# cannot return to an app yet — see MOBILE.md), PUBLIC_GOOGLE_CLIENT_ID (One
# Tap does not run in an app web view), PUBLIC_PLAUSIBLE_DOMAIN and
# PUBLIC_SENTRY_DSN (app analytics and crash reporting are their own step).

PUBLIC_API_BASE_URL=https://api.ochorus.com
PUBLIC_SITE_URL=https://ochorus.com
