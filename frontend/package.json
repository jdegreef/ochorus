{
	"name": "ochorus-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "npm run paraglide && svelte-kit sync || echo ''",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "npm run paraglide && eslint .",
		"check:slashes": "node scripts/check-slashes.mjs",
		"emblem:hues": "node scripts/generate-emblem-hues.mjs",
		"emblem:art": "node scripts/generate-emblem-art.mjs",
		"og:covers": "node scripts/generate-cover-og.mjs",
		"og:pages": "node scripts/generate-og.mjs",
		"og:sermons": "node scripts/generate-sermon-og.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"locales": "node scripts/fetch-live-locales.mjs",
		"await-api": "node scripts/await-api-release.mjs",
		"sync:catalogues": "node scripts/sync-ui-catalogues.mjs",
		"prebuild": "npm run await-api && npm run locales"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "^2.21.0",
		"@playwright/test": "^1.56.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^25.9.3",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^29.1.1",
		"satori": "^0.33.3",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource-variable/cinzel": "^5.3.0",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/fraunces": "^5.2.9",
		"@fontsource-variable/hanken-grotesk": "^5.2.8",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/im-fell-english": "^5.3.0",
		"@fontsource/libre-baskerville": "^5.3.0",
		"@fontsource/opendyslexic": "^5.2.5",
		"@sentry/sveltekit": "^10.64.0",
		"@supabase/supabase-js": "^2.108.2"
	}
}
