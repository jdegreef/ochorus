{
	"name": "ochorus-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"prepare": "npm run paraglide && svelte-kit sync || echo ''",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "npm run paraglide && eslint .",
		"check:slashes": "node scripts/check-slashes.mjs",
		"check:prerendered": "node scripts/check-content-prerendered.mjs",
		"emblem:hues": "node scripts/generate-emblem-hues.mjs",
		"emblem:art": "node scripts/generate-emblem-art.mjs",
		"og:covers": "node scripts/generate-cover-og.mjs",
		"covers:bars": "node scripts/measure-ground-bars.mjs",
		"og:pages": "node scripts/generate-og.mjs",
		"og:sermons": "node scripts/generate-sermon-og.mjs",
		"og:topics": "node scripts/generate-topic-og.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"locales": "node scripts/fetch-live-locales.mjs",
		"await-api": "node scripts/await-api-release.mjs",
		"sync:catalogues": "node scripts/sync-ui-catalogues.mjs",
		"prebuild": "npm run await-api && npm run locales",
		"postbuild": "node scripts/build-share-cards.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@inlang/paraglide-js": "^2.25.4",
		"@playwright/test": "^1.63.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.0",
		"satori": "^0.33.4",
		"sharp": "^0.35.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/cinzel": "^5.3.0",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@fontsource-variable/lora": "^5.3.0",
		"@fontsource-variable/merriweather": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource/amatic-sc": "^5.3.0",
		"@fontsource/amiri": "^5.3.0",
		"@fontsource/im-fell-english": "^5.3.0",
		"@fontsource/libre-baskerville": "^5.3.0",
		"@fontsource/martel": "^5.3.0",
		"@fontsource/noto-sans-arabic": "^5.3.0",
		"@fontsource/noto-sans-devanagari": "^5.3.0",
		"@fontsource/noto-sans-ethiopic": "^5.3.0",
		"@fontsource/noto-serif-ethiopic": "^5.3.0",
		"@fontsource/old-standard-tt": "^5.3.0",
		"@fontsource/opendyslexic": "^5.3.0",
		"@fontsource/pt-sans": "^5.3.0",
		"@fontsource/pt-serif": "^5.3.0",
		"@fontsource/tiro-devanagari-hindi": "^5.3.0",
		"@sentry/sveltekit": "^10.75.0",
		"@supabase/supabase-js": "^2.116.0"
	}
}
