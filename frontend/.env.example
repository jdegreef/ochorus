# Base URL of the Django API. In local dev, point at the backend on :8000.
# In production, leave empty if the API is served from the same origin, or set
# it to the API host (e.g. https://api.ochorus.org).
PUBLIC_API_BASE_URL=http://localhost:8000

# Public site origin, used for absolute canonical / Open Graph / sitemap URLs.
# Set to the live site (e.g. https://ochorus.com). Defaults to the Render URL.
PUBLIC_SITE_URL=http://localhost:5180

# Address shown on /contact. Defaults to support@ochorus.com.
PUBLIC_CONTACT_EMAIL=

# Supabase auth (optional in dev — login UI hides itself when unset).
# From your Supabase project: Settings → API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: browser error monitoring. Paste a Sentry DSN to turn it on (leave
# empty to disable). From your Sentry project settings.
PUBLIC_SENTRY_DSN=

# Optional: cookieless pageview analytics via Plausible. Set to the site's
# Plausible property — its `data-domain`, e.g. ochorus.com — to turn it on;
# leave empty to disable (no script, no requests). No cookies, so no consent
# banner needed. Self-hosting? Also set PUBLIC_PLAUSIBLE_SRC and add that host
# to the CSP (script-src + connect-src) in render.yaml.
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: override the Plausible script URL for a self-hosted / proxied
# instance. Defaults to Plausible Cloud (https://plausible.io/js/script.js).
PUBLIC_PLAUSIBLE_SRC=
